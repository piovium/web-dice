{
  "name": "web-dice-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter web-dice-core build && pnpm --filter web-dice build && pnpm --filter web-dice-oimo build",
    "dev": "pnpm --filter web-app dev",
    "build": "pnpm --filter web-app build",
    "build:minitool": "pnpm --filter minitool-app build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "archiver": "^8.0.0"
  }
}
