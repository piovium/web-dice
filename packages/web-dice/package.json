{
  "name": "web-dice",
  "version": "0.1.0",
  "description": "Seven-element dice rolling canvas (WASM/Rapier backend). Same API as web-dice-oimo.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-dice-core": "workspace:*",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "debounce": "^2.2.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.173.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
